---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLine from "../components/TimeLine.astro";

const title = "RJean | About";
---

<BaseLayout title={title}>
  <div class="content content--left">

  <div class="text-3xl w-full font-bold mt-20 mb-5">Yun-Chen Lee</div>

  <div class="mb-18 text-justify">
    #Digital Design  &nbsp &nbsp  #Creative Coding
  </div>

  <div class="mb-5">
    <div class="text-2xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-0 mb-10">
    <TimeLine
      title="Ph.D. Student in Architecture and Digital Design"
      subtitle="2024 - Present &nbsp|&nbsp Doctoral Program Group G (Architecture major), Institute of Civil Engineering, National Yang Ming Chiao Tung University (NYCU), Hsinchu, Taiwan"
    />
    <TimeLine
      title="M.S. in Architecture and Digital Design"
      subtitle="2021 - 2024 &nbsp|&nbsp Graduate Institute of Architecture - Digital Design Group, NYCU, Hsinchu, Taiwan"
    />
      <TimeLine
      title="B.S. in Applied Mathematics"
      subtitle="2016 - 2021 &nbsp|&nbsp Department of Applied Mathematics, NYCU, Hsinchu, Taiwan. &nbsp|&nbsp +&nbsp Cross-Disciplinary Program: Design and Innovative Technology Program (DITP)"
    />
  </div>

  <div class="mb-5">
    <div class="text-2xl w-full font-bold">Research Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLine
      title="GIA Architectural Informatics Lab (GIAAIL), NYCU"
      subtitle="2022 - Present &nbsp|&nbsp Advisor: Dr. June-Hao Hou"
    >
      <b>XNature Tech-Art Project with Soft Robotics (Group Collaboration)</b> 
      <br>- Investigated biomimetic mechanisms and designed shape-changing inflatable structures.
      <br>- Co-designed a pneumatic flower installation within a speculative design framework.
      <br class="mb-2">
      <b>Exploring Stylization Methods and Tools for Non-Uniform Point Clouds (Master's Thesis)</b>
      <br>- Proposed an NPR rendering system conceptually bridging human painterly techniques and point cloud data structures.
      <br>- Built custom downsampling and skeleton-extraction algorithms optimized for 3D Gaussian Splatting (3DGS).
    </TimeLine>
    <TimeLine
      title="ROSO Robotic Solution Lab"
      subtitle="Jun. 2025 - Present &nbsp|&nbsp Advisor: Dr. Shih-Yuan Wang"
    >
      <b>Geodesic Slicing for Robotic Arm 3D Printing (Ongoing Research)</b>
      <br>-Developing a non-planar slicing system using neural networks.
    </TimeLine>
  </div>

<div class="mb-5">
    <div class="text-2xl w-full font-bold">Publication</div>
  </div>

  <ul class="list-disc mx-6 mb-15 grid gap-2 font-light text-sm">
    <li>
      <a href="https://dl.acm.org/doi/10.1145/3757374.3771537" target="_blank">Lee, Y. C., & Hou, J. H. (in press). Generative Tonal Art: An Artistic Rendering Workflow using Programmable TAMs. Poster to be presented at SIGGRAPH Asia 2025, Hong Kong.</a>
    </li>
    <li>
      <a href="https://link.springer.com/chapter/10.1007/978-3-031-55312-7_2" target="_blank"> Lee, Y. C., & Hou, J. H. (2023, November). Point-Based Stylization: An Interactive Rendering Approach for Non-Uniform Artistic Representation. In <i>International Conference on ArtsIT, Interactivity and Game Creation</i> (pp. 14-28). Cham: Springer Nature Switzerland.</a>
    </li>
  </ul>


  <div class="mb-5">
    <div class="text-2xl w-full font-bold">Exhibition</div>
  </div>

  <ul class="list-disc mx-6 mb-15 grid gap-2 font-light text-sm">
    <li>
      Exhibiting Artist (GIAAIL Research Team), Atypical Digital Matters, GIAAIL Lab Exhibition, NYCU &nbsp|&nbsp 2024
    </li>
    <li>
      Exhibiting Artist (GIAAIL Research Team), Diffusion Couple, Kaohsiung Museum of Fine Arts  &nbsp|&nbsp 2023 - 2024
    </li>
    <li>
      Exhibiting Artist (GIAAIL Research Team), Atypical Digital Matters, GIAAIL Lab Exhibition, NYCU &nbsp|&nbsp 2024
    </li>
    <li>
      Exhibiting Artist, The Pledge - L’Engagement, Computational Aesthetics Exhibition, IAA, NYCU &nbsp|&nbsp 2023
    </li>
    <li>
      Co-curator & Exhibiting Artist, else if else, GDAP \#4 Group Exhibition, Tunglee Academy, Taipei &nbsp|&nbsp 2023
    </li>
    <li>
      Co-curator (Visual Lead), X⋅MADS, Cross-Disciplinary Programs Course Demonstration, NYCU &nbsp|&nbsp 2022
    </li>
    
  </ul>
  </div>

  </div>



