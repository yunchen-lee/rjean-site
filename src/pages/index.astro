---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
const title = "RJean Lee | Portfolio";

const totalImages = 23;

const imageNumbers = Array.from({ length: totalImages }, (_, i) => i + 1);
---

<BaseLayout title={title}>

<div class="my-10 space-y-6">
    {
      imageNumbers.map((num) => (
        <Image 
          src={`/images/portfolio/yclee-portfolio-${num}@2x.webp`} 
          alt={`Portfolio page ${num}`} 
          width="50" 
          height="50" 
          class="w-full md:w-4/5 h-auto mx-auto shadow-sm" 
        />
      ))
    }
  </div>
</div>

</BaseLayout>
