---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import WorkshopList from "../../components/WorkshopList.jsx";

const title = "RJean | Workshops";

let posts = await getCollection("workshops", ({ data }) => data.state == "Published");
posts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title={title}>
  <div class="content content--left">
    <div class="mt-10 md:mt-0 mb-10">
      <div class="text-3xl w-full font-bold">Workshops</div>
    </div>

    <WorkshopList posts={posts} client:load />
  </div>
</BaseLayout>


