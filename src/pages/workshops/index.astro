---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import WorkshopPortfolioCard from "../../components/WorkshopPortfolioCard.astro";

const title = "RJean | Workshops";

let posts = await getCollection(
  "workshops",
  ({ data }) => data.state == "Published" && data.visible !== false
);
posts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title={title}>
  <section class="portfolio-index">
    <div class="portfolio-index__intro">
      <h2>Workshops and Courses</h2>
    </div>

    <div class="portfolio-grid">
      {posts.map((workshop) => <WorkshopPortfolioCard workshop={workshop} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio-index {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 5rem;
  }

  .portfolio-index__intro {
    display: grid;
    gap: 0.5rem;
    max-width: 42rem;
  }

  .portfolio-index__intro h2 {
    margin: 0;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media screen and (min-width: 728px) {
    .portfolio-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 728px) {
    .portfolio-index {
      width: 80%;
      margin-top: 5rem;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>


