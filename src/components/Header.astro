---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";

const currentPath = Astro.url.pathname;
const activeRoute = currentPath.startsWith("/workshops")
  ? "Workshops"
  : currentPath.startsWith("/blog")
    ? "Blog"
    : currentPath.startsWith("/cv")
      ? "CV"
      : currentPath === "/" || currentPath.startsWith("/projects")
        ? "Projects"
        : null;
---

<div class="site-header" data-scroll-header>
  <header>
    <h1>
      <a href="/" class={activeRoute === "Projects" ? "current" : ""}>
        <TextSlider content=" (¦3[▓▓]=) RJean Lee" />
      </a>
    </h1>
    <span><TextSlider content="" /></span>
    <ul class="desktop-nav">
    <li>
      <a
        href="/"
        class={activeRoute === "Projects" ? "current" : ""}
        data-astro-prefetch
      >
        <TextSlider content="Projects" />
      </a>
    </li>
    <li>
      <a
        href="/blog/"
        class={activeRoute === "Blog" ? "current" : ""}
        data-astro-prefetch
      >
        <TextSlider content="Blog" />
      </a>
    </li>
    <li>
      <a
        href="/workshops/"
        class={activeRoute === "Workshops" ? "current" : ""}
        data-astro-prefetch
      >
        <TextSlider content="Workshops" />
      </a>
    </li>
    <li>
      <a
        href="/cv/"
        class={activeRoute === "CV" ? "current" : ""}
        data-astro-prefetch
      >
        <TextSlider content="CV" />
      </a>
    </li>
    </ul>
    <details class="mobile-menu">
      <summary aria-label="Open navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Main navigation">
        <a href="/" class={activeRoute === "Projects" ? "current" : ""}>
          Projects
        </a>
        <a href="/blog/" class={activeRoute === "Blog" ? "current" : ""}>
          Blog
        </a>
        <a
          href="/workshops/"
          class={activeRoute === "Workshops" ? "current" : ""}
        >
          Workshops
        </a>
        <a href="/cv/" class={activeRoute === "CV" ? "current" : ""}>
          CV
        </a>
      </nav>
    </details>
  </header>
  <Separator />
</div>

<script>
  let removeScrollHeaderListener: (() => void) | undefined;

  const initScrollHeader = () => {
    removeScrollHeaderListener?.();

    const scrollHeader = document.querySelector<HTMLElement>("[data-scroll-header]");
    if (!scrollHeader) return;

    let previousY = window.scrollY;
    let ticking = false;
    const controller = new AbortController();

    const setVisibility = (visible: boolean) => {
      scrollHeader.classList.toggle("is-hidden", !visible);
      scrollHeader.inert = !visible;
      if (!visible) {
        scrollHeader.querySelector<HTMLDetailsElement>(".mobile-menu")?.removeAttribute("open");
      }
    };

    const updateHeader = () => {
      const currentY = Math.max(window.scrollY, 0);
      const movement = currentY - previousY;

      if (currentY <= 8) {
        setVisibility(true);
      } else if (movement < -2) {
        setVisibility(true);
      } else if (movement > 2) {
        setVisibility(false);
      }

      previousY = currentY;
      ticking = false;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }, { passive: true, signal: controller.signal });

    setVisibility(window.scrollY <= 8);
    removeScrollHeaderListener = () => controller.abort();
  };

  initScrollHeader();
  document.addEventListener("astro:page-load", initScrollHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    transform: translateY(0);
    transition: transform 260ms ease;
    will-change: transform;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
  header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    font-weight: 700;
    padding: 1rem 0 0.5rem;
    gap: 1rem;
    align-items: start;
  }
  header :global(.oh) {
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  h1 {
    font-size: 1rem;
    font-weight: inherit;
    margin: 0;
    white-space: nowrap;
    min-width: 0;
  }
  h1 a {
    white-space: nowrap;
  }
  ul {
    display: flex;
    list-style: none;
    gap: 1rem;
    margin: 0;
    padding: 0;
    justify-self: end;
  }
  header > span,
  .desktop-nav {
    display: none;
  }
  .mobile-menu {
    position: relative;
    justify-self: end;
    z-index: 20;
  }
  .mobile-menu summary {
    display: grid;
    gap: 0.25rem;
    width: 1.5rem;
    padding: 0.15rem 0;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary span {
    display: block;
    height: 2px;
    width: 100%;
    background: currentColor;
  }
  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    display: grid;
    min-width: 10rem;
    padding: 0.75rem 1rem;
    gap: 0.65rem;
    text-align: right;
    background: var(--color-background, #fff);
    border: 1px solid currentColor;
  }
  @media screen and (min-width: 50em) {
    header {
      grid-template-columns: 20vw 1fr auto;
      align-items: center;
    }
    header > span,
    .desktop-nav {
      display: flex;
    }
    .mobile-menu {
      display: none;
    }
  }
</style>
