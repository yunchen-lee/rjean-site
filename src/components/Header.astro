---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";

const currentPath = Astro.url.pathname;
const routes = {
  "/": "Projects",
  "/workshops/": "Workshops",
  "/cv/": "CV",
};

const activeRoute = routes[currentPath] || null;
---

<header>
  <h1>
    <a href="/" class={activeRoute === "Projects" ? "current" : ""}>
      <TextSlider content=" (¦3[▓▓]=) RJean" />
    </a>
  </h1>
  <span><TextSlider content="" /></span>
  <ul>
    <li>
      <a
        href="/"
        class={activeRoute === "Projects" ? "current" : ""}
        data-astro-prefetch
      >
        <TextSlider content="Projects" />
      </a>
    </li>
    <li>
      <a
        href="/workshops/"
        class={activeRoute === "Workshops" ? "current" : ""}
        data-astro-prefetch
      >
        <TextSlider content="Workshops" />
      </a>
    </li>
    <li>
      <a
        href="/cv/"
        class={activeRoute === "CV" ? "current" : ""}
        data-astro-prefetch
      >
        <TextSlider content="CV" />
      </a>
    </li>
  </ul>
</header>
<Separator />

<style>
  header {
    position: relative;
    display: grid;
    grid-template-columns: min-content 1fr auto;
    font-weight: 700;
    padding: 1rem 0;
    gap: 1rem;
  }
  header a.current {
    pointer-events: none;
  }
  h1 {
    font-size: 1rem;
    font-weight: inherit;
    margin: 0;
  }
  ul {
    display: flex;
    list-style: none;
    gap: 1rem;
    margin: 0;
    padding: 0;
    justify-self: end;
  }
  @media screen and (min-width: 50em) {
    header {
      grid-template-columns: 20vw 1fr auto;
    }
  }
</style>
