---
interface Item { url: string; title: string; description?: string; image?: string | { src: string }; site?: string; }
interface Props { items: Item[]; }
const { items = [] } = Astro.props;
const imageUrl = (image?: string | { src: string }) => typeof image === "string" ? image : image?.src;
---

<div class="link-card-grid not-prose">
  {items.map((item) => (
    <a class="link-card" href={item.url} target="_blank" rel="noreferrer">
      <span class="link-card__copy">
        <strong>{item.title}</strong>
        {item.description && <span>{item.description}</span>}
        <small>{item.site ?? new URL(item.url).hostname.replace(/^www\./, "")}</small>
      </span>
      {imageUrl(item.image) && <img src={imageUrl(item.image)} alt="" loading="lazy" decoding="async" />}
    </a>
  ))}
</div>

<style>
  .link-card-grid { display: grid; gap: .75rem; margin: 1.5rem 0; }
  .link-card { display: grid; grid-template-columns: 1fr minmax(6rem, 34%); min-height: 7rem; overflow: hidden; border: 1px solid var(--border-color); border-radius: .45rem; color: inherit; }
  .link-card:hover { border-color: var(--color-text-alt); color: inherit; }
  .link-card__copy { display: flex; min-width: 0; flex-direction: column; justify-content: center; gap: .35rem; padding: .85rem 1rem; line-height: 1.35; }
  .link-card__copy strong, .link-card__copy span, .link-card__copy small { overflow: hidden; text-overflow: ellipsis; }
  .link-card__copy span { display: -webkit-box; color: var(--color-text-alt); font-size: .8rem; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .link-card__copy small { white-space: nowrap; color: var(--color-text-alt); }
  .link-card img { width: 100%; height: 100%; margin: 0; object-fit: cover; }
  @media (max-width: 34rem) { .link-card { grid-template-columns: 1fr; } .link-card img { max-height: 10rem; order: -1; } }
</style>
