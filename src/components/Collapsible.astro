---
interface Props { title?: string; open?: boolean; }
const { title = "Details", open = false } = Astro.props;
---

<details class="collapsible not-prose" open={open}>
  <summary>{title}</summary>
  <div class="collapsible__content"><slot /></div>
</details>

<style>
  .collapsible { margin: .75rem 0 1.5rem; border-bottom: 1px solid var(--border-color); }
  summary { padding: .4rem 0 .7rem; cursor: pointer; font-size: .85rem; font-weight: 500; }
  .collapsible__content { padding: 0 0 1rem; }
  .collapsible__content :global(pre) { max-height: 65vh; margin: .5rem 0 0; overflow: auto; background: #fff; border-radius: .45rem; padding: 1rem; font-size: .78rem; line-height: 1.55; }
</style>
