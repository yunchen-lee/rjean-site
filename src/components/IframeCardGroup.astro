---
interface Item { url: string; title: string; }
interface Props { items: Item[]; }
const { items = [] } = Astro.props;
const embedUrl = (url: string) => {
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes("youtube.com") && parsed.searchParams.get("v")) return `https://www.youtube-nocookie.com/embed/${parsed.searchParams.get("v")}`;
    if (parsed.hostname === "youtu.be") return `https://www.youtube-nocookie.com/embed/${parsed.pathname.slice(1)}`;
  } catch {}
  return url;
};
---

<div class:list={["iframe-grid not-prose", { "iframe-grid--multi": items.length > 1 }]}>
  {items.map((item) => (
    <figure>
      <div class="iframe-card"><iframe src={embedUrl(item.url)} title={item.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
      {item.title && <figcaption>{item.title}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .iframe-grid { display: grid; gap: 1rem; margin: 1.5rem 0; }
  .iframe-card { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #111; }
  .iframe-card iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figure { margin: 0; }
  figcaption { margin-top: .5rem; color: var(--color-text-alt); font-size: .85rem; line-height: 1.4; }
  @media (min-width: 48rem) { .iframe-grid--multi { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
