---
import type { CollectionEntry } from "astro:content";

type Props = {
  workshop: CollectionEntry<"workshops">;
};

const { workshop } = Astro.props;
---

<a
  href={`/workshops/${workshop.id}`}
  class="portfolio-card"
  data-astro-prefetch
  aria-label={workshop.data.title}
>
  <img
    src={workshop.data.cover.src}
    alt={workshop.data.cover.alt}
    loading="lazy"
    decoding="async"
    class="portfolio-card__image"
  />
  <div class="portfolio-card__body">
    <h2 class="portfolio-card__title">{workshop.data.title}</h2>
    <p class="portfolio-card__description">{workshop.data.description}</p>
  </div>
</a>

<style>
  .portfolio-card {
    display: grid;
    gap: 0.75rem;
    color: inherit;
    transition:
      transform 0.5s ease,
      opacity 0.5s ease;
  }

  .portfolio-card:hover {
    transform: translateY(-2px);
    opacity: 0.9;
    color: inherit;
  }

  .portfolio-card__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    background: var(--color-placeholder);
  }

  .portfolio-card__body {
    display: grid;
    gap: 0.15rem;
  }

  .portfolio-card__title {
    margin: 0;
    font-size: var(--font-size-card-title);
    line-height: var(--line-height-card-title);
  }

  .portfolio-card__description {
    margin: 0;
    color: var(--color-text-alt);
    line-height: 1.35;
    font-size: var(--font-size-card-body);
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>

