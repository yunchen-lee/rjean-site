---
import type { CollectionEntry } from "astro:content";

type Props = {
  workshop: CollectionEntry<"workshops">;
};

const { workshop } = Astro.props;
---

<div class="portfolio-card">
  <img
    src={workshop.data.cover.src}
    alt={workshop.data.cover.alt}
    loading="lazy"
    decoding="async"
    class="portfolio-card__image"
  />
  <div class="portfolio-card__body">
    <h2 class="portfolio-card__title">{workshop.data.title}</h2>
    <p class="portfolio-card__context">{workshop.data.context}</p>
  </div>
</div>

<style>
  .portfolio-card {
    display: grid;
    gap: 0.75rem;
    color: inherit;
  }

  .portfolio-card__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    background: var(--color-placeholder);
  }

  .portfolio-card__body {
    display: grid;
    gap: 0.15rem;
  }

  .portfolio-card__title {
    margin: 0;
    font-size: var(--font-size-card-title);
    font-weight: 700;
    line-height: var(--line-height-card-title);
  }

  .portfolio-card__context {
    margin: 0;
    color: var(--color-text-alt);
    line-height: 1.35;
    font-size: var(--font-size-card-body);
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>

